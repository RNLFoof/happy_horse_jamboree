testing = assert(SMODS.load_file("libs\\steamodded_test\\main.lua"))()
useful_things = assert(SMODS.load_file("useful_things.lua"))()
assert(SMODS.load_file("libs\\steamodded_test\\test_main.lua"))()

TestBundle = testing.TestBundle
Test = testing.Test

G.steamodded_tests.tests[] = TestBundle "horse_deck"
    * TestBundle "multiplier"
        * Test "basic"
            * testing.create_state_steps({back: "b_hhj_horse"})
            * -> 
                pool = get_current_pool("Joker")
                testing.assert_eq(useful_things.count(pool, "j_joker"), 1)
                testing.assert_eq(useful_things.count(pool, "j_hhj_shakedown"), 8)